# Automatically detect text files and normalise to LF on commit
* text=auto eol=lf

# Python and config files — always LF
*.py        text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.json      text eol=lf
*.txt       text eol=lf
*.cfg       text eol=lf
*.ini       text eol=lf
*.toml      text eol=lf
*.sh        text eol=lf
Dockerfile  text eol=lf
.env        text eol=lf
.gitignore  text eol=lf

# Windows batch files — keep CRLF
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# Binary files — do not touch
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.zip       binary
*.tar.gz    binary
*.parquet   binary
*.bin       binary
*.pt        binary
*.pkl       binary
*.onnx      binary
*.safetensors binary