#copy this file to .env and fill in the values for your environment

# eBay Developer Account
# Register at: https://developer.ebay.com
# Create an app, get client ID and secret from "Application Keys" page
EBAY_CLIENT_ID=your_ebay_client_id_here
EBAY_CLIENT_SECRET=your_ebay_client_secret_here
EBAY_ENVIRONMENT=SANDBOX          # Use SANDBOX for development, PRODUCTION for live

# AliExpress Affiliate API (if approved)
# Apply at: https://portals.aliexpress.com
ALIEXPRESS_APP_KEY=your_app_key_here
ALIEXPRESS_APP_SECRET=your_app_secret_here

# Service URLs (used by pipeline to call each module)
# When running with Docker Compose — use the service names below
# When running locally — use localhost
MEMBER1_URL=http://member1-retrieval:8001
MEMBER2_URL=http://member2-entity:8002
MEMBER3_URL=http://member3-kg:8003
MEMBER4_URL=http://member4-reranking:8004

# Python path (needed when running locally without Docker)
PYTHONPATH=.