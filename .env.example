# Copy this file to .env and fill it in. NEVER commit .env.

# App
APP_ENV=development
# Make one with: openssl rand -hex 32
SECRET_KEY=change-me-use-a-long-random-string
# Set true only when you serve the site over https
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database and cache
POSTGRES_USER=vero
POSTGRES_PASSWORD=vero
POSTGRES_DB=vero
# Used when you run the backend OUTSIDE Docker (docker compose sets its own inside Docker)
DATABASE_URL=postgresql+psycopg://vero:vero@localhost:5433/vero
REDIS_URL=redis://localhost:6380/0

# Google login
# Google Cloud Console > Credentials > OAuth client ID (Web). Client ID only.
GOOGLE_CLIENT_ID=

# eBay
# https://developer.ebay.com > Application Keys
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# PRODUCTION for real listings, SANDBOX for test items (very few)
EBAY_ENVIRONMENT=PRODUCTION
EBAY_MARKETPLACE=EBAY_US

# AliExpress (not used yet)
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=

# Team modules
# Turn a module on ONLY after it is finished and tested.
ENABLE_M1=false
ENABLE_M2=false
ENABLE_M3=false
ENABLE_M4=false
# Inside Docker use the service names below. Outside Docker use localhost.
MEMBER1_URL=http://member1-retrieval:8001
MEMBER2_URL=http://member2-entity:8002
MEMBER3_URL=http://member3-kg:8003
MEMBER4_URL=http://member4-reranking:8004
